// ==UserScript==
// @name         数据记录dv2
// @namespace    http://tampermonkey.net/
// @version      1.1
// @description  数据记录
// @author       cherries
// @match        https://www.simcompanies.com/*
// @grant        GM_download
// @grant        GM_notification
// ==/UserScript==

(function() {

    'use strict';

    const TARGET_URL = '/api/v2/companies/me/buildings/';

    // 目标页面路径（只在这个路径下生效）

    const TARGET_PAGE_PATH = '/zh-cn/landscape/';

    // 完整的域名+路径前缀

    const TARGET_FULL_PREFIX = 'https://www.simcompanies.com/zh-cn/landscape/';

    let capturedData = null;

    let summaryPanel = null;

    let openButton = null;  // 改为存储按钮元素引用

    let isOnTargetPage = false;  // 记录是否在目标页面

    // 检查当前是否在目标页面（路径精确匹配）

    function checkIsOnTargetPage() {

        const currentUrl = window.location.href;

        // 精确匹配：必须是以目标URL开头，并且后面要么结束，要么是/或?

        const isMatch = currentUrl === TARGET_FULL_PREFIX ||

                        currentUrl.startsWith(TARGET_FULL_PREFIX + '?') ||

                        currentUrl.startsWith(TARGET_FULL_PREFIX + '#');

        return isMatch;

    }

    // 移除按钮

    function removeButton() {

        if (openButton && openButton.parentNode) {

            openButton.parentNode.removeChild(openButton);

            openButton = null;

        }

        openButtonAdded = false;

    }

    // 移除浮层卡片

    function removeSummaryCard() {

        if (summaryPanel && summaryPanel.parentNode) {

            summaryPanel.parentNode.removeChild(summaryPanel);

            summaryPanel = null;

        }

    }

    function computeRestaurantSummary(buildings) {

        if (!Array.isArray(buildings)) return null;

        const restaurants = buildings.filter(b => b.kind === 'r' && b.restaurantProperties);

        if (restaurants.length === 0) return null;

        let totalSize = 0;

        let sumRating = 0, sumOccupancy = 0, sumMenuPrice = 0;

        let ratingCount = 0, occCount = 0, menuCount = 0;

        for (const r of restaurants) {

            totalSize += r.size || 0;

            const rp = r.restaurantProperties;

            if (rp.rating) { sumRating += rp.rating; ratingCount++; }

            if (rp.occupancy !== undefined) { sumOccupancy += rp.occupancy; occCount++; }

            if (rp.menuPrice) { sumMenuPrice += rp.menuPrice; menuCount++; }

        }

        return {

            count: restaurants.length,

            size: totalSize,

            rating: ratingCount ? (sumRating / ratingCount).toFixed(2) : '—',

            occupancyPercent: occCount ? ((sumOccupancy / occCount) * 100).toFixed(1) + '%' : '—',

            menuPrice: menuCount ? (sumMenuPrice / menuCount).toFixed(2) : '—'

        };

    }

    function createSummaryCard(summary) {

        if (!summary) {

            alert('未找到餐厅数据');

            return null;

        }

        // 如果已有卡片，先移除

        if (summaryPanel && summaryPanel.parentNode) {

            summaryPanel.parentNode.removeChild(summaryPanel);

        }

        const card = document.createElement('div');

        card.style.cssText = `

            position: fixed;

            top: 50%;

            left: 50%;

            transform: translate(-50%, -50%);

            background: rgba(30, 30, 42, 0.95);

            border-radius: 0px;

            padding: 20px 28px;

            box-shadow: 0 8px 20px rgba(0,0,0,0.4);

            z-index: 10001;

            font-family: 'Segoe UI', 'Roboto', 'Consolas', monospace;

            font-size: 15px;

            font-weight: normal;

            color: #f0f0f0;

            border: 1px solid #555;

            line-height: 1.8;

            min-width: 220px;

            -webkit-font-smoothing: antialiased;

            text-rendering: optimizeLegibility;

        `;

        card.innerHTML = `

            <div style="display: flex; flex-direction: column; gap: 8px;">

                <div>餐厅: <strong style="font-family: monospace; font-weight: 600;">${summary.count}</strong></div>

                <div>Size: <strong style="font-family: monospace; font-weight: 600;">${summary.size}</strong></div>

                <div>Rating: <strong style="font-family: monospace; font-weight: 600;">${summary.rating}</strong></div>

                <div>Occupancy: <strong style="font-family: monospace; font-weight: 600;">${summary.occupancyPercent}</strong></div>

                <div>Menu Price: <strong style="font-family: monospace; font-weight: 600;">${summary.menuPrice}</strong></div>

                <button id="close-summary-card" style="background:#3a3a44; border:none; color:white; padding:6px 12px; border-radius:0px; cursor:pointer; margin-top: 12px; width: 60px; align-self: center; font-family: inherit;">关闭</button>

            </div>

        `;

        document.body.appendChild(card);

        summaryPanel = card;

        const closeBtn = card.querySelector('#close-summary-card');

        closeBtn.addEventListener('click', () => {

            if (summaryPanel && summaryPanel.parentNode) {

                summaryPanel.parentNode.removeChild(summaryPanel);

                summaryPanel = null;

            }

        });

        return card;

    }

    function showSummary() {

        if (!capturedData) {

            alert('尚未捕获到建筑数据，请刷新页面等待 API 请求。');

            return;

        }

        const summary = computeRestaurantSummary(capturedData);

        createSummaryCard(summary);

    }

    let openButtonAdded = false;

    function addOpenButton() {

        // 只在目标页面且按钮尚未添加时才添加

        if (!isOnTargetPage || openButtonAdded) return;

        const btn = document.createElement('button');

        btn.textContent = '餐厅汇总';

        btn.style.cssText = `

            position: fixed;

            bottom: 180px;

            right: 20px;

            z-index: 300;

            padding: 4px 8px;

            background-color: #000000;

            color: white;

            border: 1px solid #444;

            border-radius: 0px;

            font-size: 10px;

            font-weight: normal;

            cursor: pointer;

            box-shadow: none;

            font-family: system-ui, sans-serif;

            width: auto;

            height: auto;

            line-height: 2;

            opacity: 0.8;

            transition: opacity 0.2s;

        `;

        btn.onmouseover = () => btn.style.opacity = '1';

        btn.onmouseout = () => btn.style.opacity = '0.8';

        btn.onclick = showSummary;

        document.body.appendChild(btn);

        openButton = btn;

        openButtonAdded = true;

    }

    // 处理页面切换时的逻辑

    function handlePageChange() {

        const nowOnTarget = checkIsOnTargetPage();

        if (nowOnTarget !== isOnTargetPage) {

            isOnTargetPage = nowOnTarget;

            if (isOnTargetPage) {

                // 进入目标页面：添加按钮（如果已有数据）

                addOpenButton();

            } else {

                // 离开目标页面：移除按钮和卡片

                removeButton();

                removeSummaryCard();

            }

        }

    }

    // 监听 fetch 请求（只在目标页面捕获）

    const originalFetch = window.fetch;

    window.fetch = function(...args) {

        const url = typeof args[0] === 'string' ? args[0] : args[0]?.url;

        if (url && url.includes(TARGET_URL) && isOnTargetPage) {

            return originalFetch.apply(this, args).then(async (response) => {

                const clone = response.clone();

                try {

                    capturedData = await clone.json();

                    console.log('捕获数据', capturedData?.length);

                    addOpenButton();

                } catch(e) {}

                return response;

            });

        }

        return originalFetch.apply(this, args);

    };

    // 监听 XHR 请求（只在目标页面捕获）

    const XHR = XMLHttpRequest.prototype;

    const originalOpen = XHR.open;

    const originalSend = XHR.send;

    XHR.open = function(method, url, ...rest) {

        this._url = url;

        return originalOpen.apply(this, [method, url, ...rest]);

    };

    XHR.send = function(...args) {

        this.addEventListener('load', function() {

            if (this._url && this._url.includes(TARGET_URL) && isOnTargetPage && this.status === 200) {

                try {

                    capturedData = JSON.parse(this.responseText);

                    console.log('捕获数据', capturedData?.length);

                    addOpenButton();

                } catch(e) {}

            }

        });

        return originalSend.apply(this, args);

    };

    // 监听 URL 变化（SPA 路由切换）

    let lastUrl = window.location.href;

    const observer = new MutationObserver(() => {

        const currentUrl = window.location.href;

        if (currentUrl !== lastUrl) {

            lastUrl = currentUrl;

            handlePageChange();

        }

    });

    observer.observe(document, { subtree: true, childList: true });

    // 初始化：检查当前页面

    isOnTargetPage = checkIsOnTargetPage();

    if (isOnTargetPage) {

        // 如果在目标页面，尝试添加按钮（等DOM加载完成）

        if (document.readyState === 'loading') {

            document.addEventListener('DOMContentLoaded', () => addOpenButton());

        } else {

            setTimeout(addOpenButton, 1000); // 稍微延迟确保页面稳定

        }

    }

    // 可选：监听 popstate 事件（浏览器前进后退）

    window.addEventListener('popstate', handlePageChange);

})();
